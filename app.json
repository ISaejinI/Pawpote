{
  "expo": {
    "name": "pawpote",
    "slug": "pawpote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icons/icon.png",
    "scheme": "pawpote",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/app-icons/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D6CCFF",
        "foregroundImage": "./assets/app-icons/adaptive-icon.png",
        "backgroundImage": "./assets/app-icons/adaptive-icon-background.png",
        "monochromeImage": "./assets/app-icons/monochrome-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/app-icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D6CCFF",
          "image": "./assets/app-icons/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PawPote utilise ta position pour calculer la distance des chiens autour de toi."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PawPote accède à tes photos pour que tu puisses choisir celles de ton chien et la tienne.",
          "cameraPermission": "PawPote utilise l’appareil photo pour que tu puisses photographier ton chien."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
